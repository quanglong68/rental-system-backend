# Mau bien moi truong cho local dev (docs muc 12).
# Cach dung: copy file nay thanh .env (cung thu muc repo root) roi dien gia tri that.
# File .env KHONG commit len git. Moi secret o day chi la placeholder.
# Quy uoc user rieng theo DB: <PREFIX>_DB_USER / <PREFIX>_DB_PASSWORD
# (vd auth_db -> AUTH_DB_USER), init-multiple-dbs.sh tu tao role + grant.

# --- JWT (auth-service + api-gateway, toi thieu 32 ky tu, HS256, iss=rental-auth) ---
JWT_SECRET=your_32_character_secret_here
JWT_ISSUER=rental-auth

# --- Postgres superuser (chi dung de khoi tao lan dau) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_dot_env
POSTGRES_DB=postgres
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,property_db,listing_db,contract_db,billing_db,asset_db

# --- User rieng tung service (moi service chi co quyen tren DB cua minh, docs muc 4.3) ---
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_in_dot_env
USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me_in_dot_env
PROPERTY_DB_USER=property_svc
PROPERTY_DB_PASSWORD=change_me_in_dot_env
LISTING_DB_USER=listing_svc
LISTING_DB_PASSWORD=change_me_in_dot_env
CONTRACT_DB_USER=contract_svc
CONTRACT_DB_PASSWORD=change_me_in_dot_env
BILLING_DB_USER=billing_svc
BILLING_DB_PASSWORD=change_me_in_dot_env
ASSET_DB_USER=asset_svc
ASSET_DB_PASSWORD=change_me_in_dot_env

# --- Kafka (KRaft 1 broker, dev) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Eureka ---
EUREKA_URL=http://discovery-server:8761/eureka/

# --- MinIO (anh bao hu, bucket report-images) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_dot_env
MINIO_ENDPOINT=http://minio:9000

# --- Gateway CORS cho web/app client (docs muc 4.2) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
