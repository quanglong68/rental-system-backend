# ==============================================================================
# Biến môi trường mẫu cho Hệ thống Rental System Microservices
# Copy file này thành .env ở thư mục rental-system-backend/ trước khi khởi chạy
# ==============================================================================

# PostgreSQL Root & Đa Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,property_db,listing_db,contract_db,billing_db,asset_db,chat_db

# Mật khẩu database cho từng microservice
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_auth_password

USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me_user_password

PROPERTY_DB_USER=property_svc
PROPERTY_DB_PASSWORD=change_me_property_password

LISTING_DB_USER=listing_svc
LISTING_DB_PASSWORD=change_me_listing_password

CONTRACT_DB_USER=contract_svc
CONTRACT_DB_PASSWORD=change_me_contract_password

BILLING_DB_USER=billing_svc
BILLING_DB_PASSWORD=change_me_billing_password

ASSET_DB_USER=asset_svc
ASSET_DB_PASSWORD=change_me_asset_password

CHAT_DB_USER=chat_svc
CHAT_DB_PASSWORD=change_me_chat_password

# JWT Configuration (tối thiểu 32 ký tự cho HS256)
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters_long
JWT_ISSUER=rental-auth

# CORS Gateway
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8443,https://localhost:8443

# Kafka Cluster ID
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_LICENSE_TOKEN=

# Notification: Email (SMTP) & Push (Firebase FCM)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=noreply@rentalsystem.vn
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

NOTIFICATION_PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Billing Configuration
BILLING_CLOSING_DAY=1
BILLING_DUE_DAYS=7
